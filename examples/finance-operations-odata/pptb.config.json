{
  "invocation": {
    "version": "1.0.0",
    "capabilities": ["finance-operations-odata-read"],
    "prefill": {
      "properties": {
        "operation": { "type": "string", "enum": ["query", "serviceDocument", "metadata"] },
        "query": { "type": "string" },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "returnTopic": {
      "properties": {
        "page": { "type": "object" },
        "serviceDocument": { "type": "object" },
        "metadata": { "type": "string" }
      }
    }
  },
  "agents": {
    "version": "1.0.0",
    "invokable": true,
    "modes": ["two-way"],
    "defaultMode": "two-way",
    "timeoutMS": 120000,
    "headless": true,
    "headlessEntry": "dist/headless.js"
  }
}
